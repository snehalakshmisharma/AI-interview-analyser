# ============================================================
# AI Interview Analyzer — Environment Configuration
# ============================================================
# Copy this file to .env and update the values for your local
# or deployment environment. Do not commit your real .env file.

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------
# Generate a secure secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# ------------------------------------------------------------
# GOOGLE OAUTH (optional)
# ------------------------------------------------------------
# Create the app in Google Cloud Console and set the redirect URL:
# http://localhost:3000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

# ------------------------------------------------------------
# OIDC / SSO (optional)
# ------------------------------------------------------------
# Commonly used for Microsoft Entra ID or other enterprise providers
OIDC_CLIENT_ID=your_oidc_client_id
OIDC_CLIENT_SECRET=your_oidc_client_secret
OIDC_ISSUER_URL=https://your-oidc-provider.example.com
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback

# ------------------------------------------------------------
# AI EVALUATION
# ------------------------------------------------------------
# Use "demo" for local heuristic evaluation without API keys.
# Use "real" to enable Gemini-based evaluation.
AI_MODE=demo

# Required when AI_MODE=real
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# WHISPER TRANSCRIPTION
# ------------------------------------------------------------
# Local transcription endpoint used by the app.
WHISPER_API_URL=http://localhost:8001/transcribe
WHISPER_MODEL=base

# ------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------
# Public URL used by the app and auth flows.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AI_MODE=demo