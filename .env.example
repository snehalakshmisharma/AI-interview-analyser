# ============================================================
# AI Placement Interview Analyzer — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
# PostgreSQL connection URL
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/app_db

# ------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------
# Strong random secret for JWT signing (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here

# ------------------------------------------------------------
# GOOGLE OAUTH (optional)
# ------------------------------------------------------------
# Get these from https://console.cloud.google.com/
# Authorized redirect URI must include:
#   http://localhost:3000/api/auth/oauth/google/callback  (development)
#   https://your-domain.com/api/auth/oauth/google/callback  (production)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

# ------------------------------------------------------------
# SSO / OIDC (optional — for institutional login)
# ------------------------------------------------------------
OIDC_CLIENT_ID=your_oidc_client_id
OIDC_CLIENT_SECRET=your_oidc_client_secret
OIDC_ISSUER_URL=https://your-oidc-provider.example.com
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback

# ------------------------------------------------------------
# AI ANALYSIS (Google Gemini)
# ------------------------------------------------------------
# Set to "demo" for heuristic analysis (no API key needed)
# Set to "real" to use Google Gemini AI
AI_MODE=demo

# Required when AI_MODE=real
# Get your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# APPLICATION (public — safe to expose to browser)
# ------------------------------------------------------------
# Base URL of this application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used to show "DEMO" badge in UI when in demo mode
NEXT_PUBLIC_AI_MODE=demo